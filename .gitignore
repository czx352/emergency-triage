__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# 原始数据不入库（MIMIC 有数据使用协议，不能二次分发）
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# 模型权重与实验产物：只保留可复现所需的指标、混淆矩阵与图
artifacts/*
!artifacts/*.json
!artifacts/*.csv
!artifacts/summary.md
!artifacts/main.pt
!artifacts/figures/

# 打包产物与构建缓存
dist/
build/
*.log
logs/
logs_*.txt

.env
.env.*
!/.env.example
